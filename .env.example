# Copy this file to .env.local and fill in the values. Never commit .env.local.

# MongoDB (same database as fixmate-server)
CS_MONGODB_URI=
CS_DB_NAME=fixmate

# BetterAuth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Must match CS_JWT_SECRET in fixmate-server/.env
CS_JWT_SECRET=

# Express API base URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google login (optional)
CS_GOOGLE_CLIENT_ID=
CS_GOOGLE_CLIENT_SECRET=
